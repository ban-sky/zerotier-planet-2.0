extends controller_layout

block content
  .page-head
    div
      p.eyebrow= t('overview.eyebrow')
      h1= t('overview.title')
    a.btn.btn-primary(href='/controller/network/create')= t('btn.newNetwork')

  if error
    .alert.alert-error= error
  else
    .stat-grid
      .stat
        span.stat-label= t('overview.addressLabel')
        strong.mono= zt_status.address
      .stat
        span.stat-label= t('overview.versionLabel')
        strong= zt_status.version

    .metric-grid
      .metric
        span.stat-label= t('overview.cpuLabel')
        strong.metric-value(data-stat='cpu')= stats.cpuPercent === null ? '—' : stats.cpuPercent + '%'
        .meter
          span.meter-fill(data-bar='cpu', data-value=stats.cpuPercent === null ? 0 : stats.cpuPercent)
        p.metric-hint(data-stat='cpu-hint', data-template=t('overview.cpuHint'), data-stale=t('overview.statsStale'))= stats.cpuPercent === null ? t('overview.statsStale') : t('overview.cpuHint', { cores: stats.cores || '-', app: stats.cpuAppPercent === null ? '-' : stats.cpuAppPercent })
      .metric
        span.stat-label= t('overview.memLabel')
        strong.metric-value(data-stat='mem')= stats.memPercent === null ? '—' : stats.memPercent + '%'
        .meter
          span.meter-fill(data-bar='mem', data-value=stats.memPercent === null ? 0 : stats.memPercent)
        p.metric-hint(data-stat='mem-hint', data-template=t('overview.memHint'), data-stale=t('overview.statsStale'))= stats.memPercent === null ? t('overview.statsStale') : t('overview.memHint', { used: stats.memUsedMb, total: stats.memTotalMb, app: stats.memAppMb === null ? '-' : stats.memAppMb })

    .card.conn-card
      .card-head
        div
          h2= t('overview.networkTitle')
          p.card-subtitle= t('overview.networkHint')
      .conn-grid
        .conn-item
          span.conn-label= t('overview.peersLabel')
          strong.conn-value(data-stat='peers')= stats.peers === null ? '—' : stats.peers
        .conn-item
          span.conn-label= t('overview.directLabel')
          strong.conn-value(data-stat='direct')= stats.direct === null ? '—' : stats.direct
        .conn-item
          span.conn-label= t('overview.relayLabel')
          strong.conn-value(data-stat='relay')= stats.relay === null ? '—' : stats.relay
        .conn-item
          span.conn-label= t('overview.pathsLabel')
          strong.conn-value(data-stat='paths')= stats.paths === null ? '—' : stats.paths
