extends users_layout

block users_content
  if message
    .alert.alert-info= message

  .card.form-card
    h2= t('btn.setPassword')
    p.card-subtitle= t('password.subtitle')

    form.form-stack(method='POST', action='')
      .field
        label(for='username')= t('field.username')
        input#username(type='text', name='username', value=user.name, readonly=readonly, autocomplete='username')
      .field
        label(for='password1')= t('field.newPassword')
        input#password1(type='password', name='password1', autocomplete='new-password', minlength='10', maxlength='160', placeholder=t('password.placeholder'), required, autofocus)
      .field
        label(for='password2')= t('field.confirmPassword')
        input#password2(type='password', name='password2', autocomplete='new-password', minlength='10', maxlength='160', placeholder=t('password.placeholderRepeat'), required)
      label.check-row
        input#pass_set(type='checkbox', name='pass_set', value='check')
        span
          strong= t('password.requireChange')
          span.check-hint= t('password.requireChangeHint')
      .form-actions
        button.btn.btn-primary(type='submit')= t('btn.savePassword')
        a.btn.btn-ghost(href='/users')= t('btn.cancel')

  if errors
    .alert.alert-error
      ul.list-tight
        each err in errors
          li= err.msg
