extends login_layout

block login_content
  img.auth-logo(src='/images/zt-mark.svg', alt='', width='60', height='60')
  h1.auth-title= t('login.title')

  if message
    .alert.alert-info= message

  form.form-stack(method='POST', action='')
    .field
      label.sr-only(for='username')= t('field.username')
      input#username(type='text', name='username', autocomplete='username', placeholder=t('field.username'), required, autofocus)
    .field
      label.sr-only(for='password')= t('field.password')
      input#password(type='password', name='password', autocomplete='current-password', placeholder=t('field.password'), required)
    button.btn.btn-primary.btn-block(type='submit')= t('btn.signIn')

  p.auth-footnote
    a(href='/')= t('login.backToPlanet')
